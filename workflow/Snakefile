# Reproducibility DAG for the d-SEAMS 2.0 paper numbers.
#
# Run from the repository root inside the pixi environment, on one
# exclusively allocated node (scripts/elja_submit.sh does both):
#
#   pixi run -- snakemake -s workflow/Snakefile --configfile config/config.yaml --cores all
#
# The engine (seams-core), its baseline commit, linkcell and both language
# front ends are locked components in config/ecosystem-lock.json and are
# materialized under sources/ by `scripts/elja_submit.sh prep` (compute
# nodes carry neither git nor network access). Heavy rules execute through
# HyperQueue when an `hq` server is reachable; set SEAMS_NO_HQ=1 or run
# without hq on PATH to execute the same commands directly.

import json
import os
import shutil

configfile: "config/config.yaml"

# Host cargo configuration (a user-level linker choice, say) must not leak
# into the locked Rust builds; an explicit RUSTFLAGS wins over ~/.cargo
RUST_ENV = 'export RUSTFLAGS="${{SEAMS_RUSTFLAGS:-}}"; '

ROOT = os.path.abspath(".")
R = "results"
LOCK = "config/ecosystem-lock.json"
# Build directories default to the working tree but move to node-local
# storage (SEAMS_BUILD_ROOT) on clusters whose NFS clocks skew against
# the nodes, which meson refuses
BUILD = os.path.abspath(os.environ.get("SEAMS_BUILD_ROOT", "."))
TIP_BUILD = os.path.join(BUILD, "build-repro")
BASE_BUILD = os.path.join(BUILD, "build-base")
SOURCE_ROOT = os.path.abspath(
    os.environ.get("DSEAMS_SOURCE_ROOT", os.path.join(ROOT, "sources"))
)
with open(LOCK, encoding="utf-8") as lock_file:
    SOURCE_LOCK = json.load(lock_file)


def component(name):
    return os.path.join(SOURCE_ROOT, SOURCE_LOCK["components"][name]["directory"])


CORE = component("seams-core")
BASE_TREE = component("seams-base")
PYTHON_ROOT = component("pydseamslib")
YODA_ROOT = component("yodastruct")
CORE_INPUT = os.path.join(CORE, "input")
PYTHON_SITE = os.path.join(BUILD, "python-site")
YODA_BUILD = os.path.join(BUILD, "build-yoda")
LUA_EXE = shutil.which("lua") or "lua"
ABS = lambda p: os.path.join(ROOT, p)


def hq(cpus):
    if os.environ.get("SEAMS_NO_HQ") or shutil.which("hq") is None:
        return ""
    return ("hq submit --wait --cpus {} "
            "--stdout results/hq-%{{JOB_ID}}.stdout "
            "--stderr results/hq-%{{JOB_ID}}.stderr --").format(cpus)


FIGSHARE_DIR = config.get("figshare_dir", "data/figshare")
FIGSHARE_FILES = [
    "nucleation.lammpstrj",
    "mW_cubic.lammpstrj",
    "dump-240-square.lammpstrj",
    "dump-6-320-310.lammpstrj",
    "dump-320.lammpstrj",
]
PUBLIC_ICE_DIR = config.get("public_ice_dir", "data/public-ice")
# name -> (relative path inside PUBLIC_ICE_DIR, oxygen type)
PUBLIC_DUMPS = {
    "niu-traj1-extract": ("nucleation/Ice_nucleation_trajectory/Nucleation_trajectory-1", 1),
    "niu-traj2-foursite": ("nucleation/Ice_nucleation_trajectory/Nucleation_trajectory-2", 1),
    "niu-traj3-oxygen": ("nucleation/Ice_nucleation_trajectory/Nucleation_trajectory-3", 1),
    "niu-critical-growing": ("critical/Critical-nucleus_analysis-trajectory/Critical-nucleus-analysis-growing", 1),
    "niu-critical-melting": ("critical/Critical-nucleus_analysis-trajectory/Critical-nucleus-analysis-melting", 1),
}
WALK_STRIDE = config.get("walk_stride", 1)
SWEEP_SEEDS = config.get("sweep_seeds", 5)
SWEEP_SIGMAS = config.get("sweep_sigmas", [0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4])


rule all:
    input:
        R + "/paper_manifest.json",


rule conditions:
    output:
        R + "/conditions.txt",
    params:
        base=config["base_sha"],
        core=CORE,
    shell:
        r"""
        {{
          echo "hostname: $(hostname)"
          echo "jobid: ${{SLURM_JOB_ID:-none}}"
          echo "partition: ${{SLURM_JOB_PARTITION:-none}}"
          echo "tip_sha: $(git -C {params.core} rev-parse HEAD 2>/dev/null || echo unknown)"
          echo "base_sha: {params.base}"
          echo "repro_sha: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
          echo "hq: $(hq --version 2>/dev/null || echo absent)"
          lscpu | grep -E 'Model name|Socket|Core|Thread' || true
          echo "loadavg_at_start: $(cut -d' ' -f1 /proc/loadavg)"
        }} > {output}
        """


rule source_manifest:
    input:
        lock=LOCK,
    output:
        R + "/source-manifest.json",
    params:
        root=SOURCE_ROOT,
    shell:
        "python scripts/ecosystem_sources.py --lock {input.lock} manifest "
        "--root {params.root} --output {output}"


rule setup_tip:
    input:
        R + "/source-manifest.json",
    output:
        touch(R + "/tip-setup.done"),
    params:
        log=R + "/tip-setup.log",
        bdir=TIP_BUILD,
        core=CORE,
    shell:
        "meson setup {params.bdir} {params.core} --prefix=$CONDA_PREFIX "
        "--buildtype=release -Dwith_python=false -Dwith_tests=true "
        "> {params.log} 2>&1"


rule build_tip:
    input:
        R + "/tip-setup.done",
    output:
        touch(R + "/tip-build.done"),
    params:
        hq=lambda wc: hq(8),
        bdir=TIP_BUILD,
    shell:
        RUST_ENV + "{params.hq} meson compile -C {params.bdir}"


rule identity_gate:
    # A red suite aborts the DAG; no table row is emitted from a red tree
    input:
        R + "/tip-build.done",
    output:
        R + "/tip-test.log",
    params:
        hq=lambda wc: hq(8),
        bdir=TIP_BUILD,
    shell:
        RUST_ENV + "{params.hq} bash -c 'meson test -C {params.bdir} > {output} 2>&1'"


rule install_python:
    input:
        gate=R + "/tip-test.log",
        source=R + "/source-manifest.json",
    output:
        touch(R + "/py-install.done"),
    params:
        source=PYTHON_ROOT,
        site=PYTHON_SITE,
    shell:
        RUST_ENV + "python -m pip install --no-build-isolation --no-deps --upgrade "
        "--target {params.site} {params.source} && "
        "PYTHONPATH={params.site}:${{PYTHONPATH:-}} "
        "python -c 'import pydseams; print(pydseams.__file__)'"


rule build_base:
    input:
        R + "/source-manifest.json",
    output:
        touch(R + "/base-build.done"),
    params:
        tree=BASE_TREE,
        bbuild=BASE_BUILD,
        hq=lambda wc: hq(8),
    shell:
        r"""
        test -d {params.tree} || {{ echo "baseline tree missing; run scripts/elja_submit.sh prep" >&2; exit 1; }}
        export RUSTFLAGS="${{SEAMS_RUSTFLAGS:-}}"
        meson setup {params.bbuild} {params.tree} --buildtype=release \
          -Dwith_python=false -Dwith_tests=false > results/base-setup.log 2>&1
        {params.hq} meson compile -C {params.bbuild}
        """


rule base_drivers:
    # The baseline predates the bench targets; its drivers compile directly
    # against the baseline library
    input:
        R + "/base-build.done",
    output:
        scaling=R + "/base_bench_scaling",
        cages=R + "/base_bench_cages",
    params:
        tree=BASE_TREE,
        bbuild=BASE_BUILD,
        core=CORE,
    shell:
        r"""
        EIGEN=$CONDA_PREFIX/include/eigen3
        INC="-I{params.tree}/src/include/internal -I{params.tree}/src/include/external -I$EIGEN"
        LINK="-L{params.bbuild}/src -lyodaLib -Wl,-rpath,{params.bbuild}/src -Wl,--enable-new-dtags -Wl,--allow-shlib-undefined"
        g++ -std=c++20 -O2 -o {output.scaling} {params.core}/tests/bench_scaling.cpp $INC $LINK
        g++ -std=c++20 -O2 -o {output.cages} {params.core}/tests/bench_cages_base.cpp $INC $LINK
        """


rule tip_scaling:
    input:
        R + "/tip-test.log",
    output:
        R + "/tip-scaling.txt",
    params:
        cwd=CORE_INPUT,
        out=lambda wc, output: ABS(output[0]),
        hq=lambda wc: hq(1),
        tbuild=TIP_BUILD,
        sizes=" ".join(str(s) for s in config["scaling_sizes"]),
    shell:
        "{params.hq} bash -c 'cd {params.cwd} && OMP_NUM_THREADS=1 "
        "{params.tbuild}/tests/bench_scaling {params.sizes} > {params.out}'"


rule base_scaling:
    input:
        R + "/base_bench_scaling",
    output:
        R + "/base-scaling.txt",
    params:
        cwd=CORE_INPUT,
        out=lambda wc, output: ABS(output[0]),
        bin=lambda wc, input: ABS(input[0]),
