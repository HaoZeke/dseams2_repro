# --- Applications: per-frame comparison with CHILL+ on public trajectories


rule walk_figshare:
    # CHILL+ counts and largest cluster, cage membership on the cutoff graph,
    # seeded assignment; every frame of the 148-frame mW nucleation deposit
    input:
        gate=R + "/tip-test.log",
        traj=FIGSHARE_DIR + "/nucleation.lammpstrj",
    output:
        R + "/walks/figshare-nucleation.txt",
    params:
        hq=lambda wc: hq(1),
        tbuild=TIP_BUILD,
    shell:
        "{params.hq} bash -c 'OMP_NUM_THREADS=1 "
        "{params.tbuild}/tests/walk_compare {input.traj} 0 1 1 > {output}'"


rule walk_public:
    input:
        gate=R + "/tip-test.log",
        source=PUBLIC_ICE_DIR + "/SOURCE.json",
    output:
        R + "/walks/{dump}.txt",
    wildcard_constraints:
        dump="niu-.+",
    params:
        hq=lambda wc: hq(1),
        tbuild=TIP_BUILD,
        traj=lambda wc: os.path.join(PUBLIC_ICE_DIR, PUBLIC_DUMPS[wc.dump][0]),
        otype=lambda wc: PUBLIC_DUMPS[wc.dump][1],
        stride=WALK_STRIDE,
    shell:
        "{params.hq} bash -c 'OMP_NUM_THREADS=1 "
        "{params.tbuild}/tests/walk_compare {params.traj} 0 {params.otype} "
        "{params.stride} > {output}'"


# --- Comparison with existing tools on labelled lattices


rule sota_sweep:
    # Per-molecule accuracy of every runnable classifier on jittered Ic and
    # Ih lattices and a disordered null, repeated over seeds, with the wall
    # time of each method on the same frames
    input:
        py=R + "/py-install.done",
        gate=R + "/tip-test.log",
    output:
        R + "/sota_compare.txt",
    params:
        hq=lambda wc: hq(4),
        site=PYTHON_SITE,
        tbuild=TIP_BUILD,
        seeds=SWEEP_SEEDS,
        sigmas=" ".join(str(s) for s in SWEEP_SIGMAS),
        liquid=config.get("liquid_data", "data/mW_liquid_T215_512.data"),
    shell:
        "{params.hq} bash -c "
        "'LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH "
        "PYTHONPATH={params.site}:${{PYTHONPATH:-}} OMP_NUM_THREADS=1 "
        "SEAMS_BUILD={params.tbuild} "
        "python scripts/sota_compare.py --seeds {params.seeds} "
        "--sigmas {params.sigmas} --liquid-data {params.liquid} > {output}'"



rule genice_atlas:
    # Specificity over the GenIce polymorph library: ice I positives,
    # dense polymorphs, empty clathrate frameworks, porous ices and
    # amorphous networks, ideal and under positional noise
    input:
        py=R + "/py-install.done",
        gate=R + "/tip-test.log",
    output:
        R + "/genice_atlas.txt",
    params:
        hq=lambda wc: hq(2),
        site=PYTHON_SITE,
        tbuild=TIP_BUILD,
    shell:
        "{params.hq} bash -c "
        "'LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH "
        "PYTHONPATH={params.site}:${{PYTHONPATH:-}} OMP_NUM_THREADS=1 "
        "SEAMS_BUILD={params.tbuild} "
        "python scripts/genice_atlas.py > {output}'"


rule ion_atlas:
    # Ice labels of the water network around substitutional Na and Cl in
    # GenIce ice Ih, Ic and the sI framework, ions removed from the graph
    input:
        py=R + "/py-install.done",
        gate=R + "/tip-test.log",
    output:
        R + "/ion_atlas.txt",
    params:
        hq=lambda wc: hq(2),
        site=PYTHON_SITE,
        tbuild=TIP_BUILD,
    shell:
        "{params.hq} bash -c "
        "'LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH "
        "PYTHONPATH={params.site}:${{PYTHONPATH:-}} OMP_NUM_THREADS=1 "
        "SEAMS_BUILD={params.tbuild} "
        "python scripts/ion_atlas.py > {output}'"


rule polymorph_library:
    # Topology key library over the GenIce lattices (three hops, mutual
    # four-nearest graph) read back against the jittered ice I lattices and
    # the displaced atlas. Needs the engine's topology keys (pydseamslib
    # 2.8 or later); not part of the manifest until the lock carries them.
    input:
        py=R + "/py-install.done",
        gate=R + "/tip-test.log",
    output:
        library=R + "/polymorph_library.txt",
        match=R + "/polymorph_match.txt",
    params:
        hq=lambda wc: hq(2),
        site=PYTHON_SITE,
        tbuild=TIP_BUILD,
    shell:
        "{params.hq} bash -c "
        "'LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH "
        "PYTHONPATH={params.site}:${{PYTHONPATH:-}} OMP_NUM_THREADS=1 "
        "SEAMS_BUILD={params.tbuild} "
        "python scripts/polymorph_library.py --hops 3 --library-out {output.library} "
        "> {output.match}'"

rule aggregate:
    input:
        conditions=R + "/conditions.txt",
        source=R + "/source-manifest.json",
        parity=R + "/workflow-parity.json",
        gate=R + "/tip-test.log",
        tip_scaling=R + "/tip-scaling.txt",
        base_scaling=R + "/base-scaling.txt",
        tip_cages=R + "/tip-cages.txt",
        base_cages=R + "/base-cages.txt",
        overhead=R + "/tip-overhead.txt",
        strong=expand(
            R + "/tip-strong-t{t}.txt", t=config["strong_threads"]
        ),
        trajectory=R + "/trajectory-incremental.txt",
        ql_dseams=R + "/ql-dseams.txt",
        ql_python=R + "/ql-python.txt",
        figshare_demos=R + "/figshare-demos/figshare-demos.json",
        atlas=R + "/genice_atlas.txt",
        ions=R + "/ion_atlas.txt",
        figshare_notebooks=expand(
            R + "/notebooks/{nb}.ipynb", nb=NOTEBOOKS
        ),
        figshare_incremental=R + "/figshare-incremental.json",
        pipeline=R + "/tip-pipeline.txt",
        incremental=expand(
            R + "/tip-incremental-{n}.txt", n=config["scaling_sizes"]
        ),
        stages_cubic=R + "/tip-stages-cubic.txt",
        stages_nucleation=R + "/tip-stages-nucleation.txt",
        walks=[R + "/walks/figshare-nucleation.txt"]
        + expand(R + "/walks/{dump}.txt", dump=list(PUBLIC_DUMPS)),
        sota=R + "/sota_compare.txt",
    output:
        R + "/paper_manifest.json",
    params:
        results=R,
    shell:
        "python scripts/aggregate.py {params.results} > {output}"
